source "https://rubygems.org"

gem "minimal-mistakes-jekyll", "~> 4.28"
gem "webrick", "~> 1.9"

# Windows requires tzinfo and tzinfo-data for Jekyll to calculate timezone properly
gem "tzinfo", "~> 2.0"
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-include-cache"
end

